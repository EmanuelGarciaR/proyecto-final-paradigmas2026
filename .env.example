# =============================================================================
# Chivas Rumberas — Configuración Global Editable (Docker Compose & Benchmark)
# =============================================================================

# ── Docker Hub ───────────────────────────────────────────────────────────────
DOCKERHUB_USER=emagarciar
IMAGE_TAG=latest

# ── Límites de Recursos Equivalentes para los 3 Backends ─────────────────────
BACKEND_CPUS=1.0
BACKEND_MEM_LIMIT=512m

# ── Base de Datos Réplica (PostgreSQL en Volumen Docker Propio) ──────────────
POSTGRES_USER=chivas
POSTGRES_PASSWORD=chivas_secret_2026
POSTGRES_DB=chivas_rumberas
POSTGRES_PORT=5432

# ── Puertos Expuestos en Host ────────────────────────────────────────────────
FRONTEND_PORT=3000
EXPRESS_PORT=3001
JAVA_PORT=3002
SCALA_PORT=3003
GRAFANA_PORT=3004
PROMETHEUS_PORT=9090
CADVISOR_PORT=8080

# ── Modo de Integraciones Externas (mock | real) ─────────────────────────────
INTEGRATIONS_MODE=mock
MOCK_LATENCY_MS=50
DISABLE_RATE_LIMIT=false

# ── Seguridad JWT (Idéntica en los 3 Backends) ───────────────────────────────
JWT_SECRET=chivas_rumberas_super_secret_jwt_key_2026_benchmark
JWT_EXPIRES_IN=8h

# ── Cloudinary (Valores homologados para firma SHA-1 en /uploads/signature) ──
CLOUDINARY_CLOUD_NAME=chivas-rumberas-demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=cloudinary_secret_for_signature_test

# ── Credenciales Grafana ─────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
