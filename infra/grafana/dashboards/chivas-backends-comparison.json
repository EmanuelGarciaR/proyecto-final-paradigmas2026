      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Tiempo de Arranque por Backend (s)",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "max by (backend) (chivas_rumberas_startup_duration_seconds)",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Total Peticiones Entrantes (Acumulado sin /health ni /metrics)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum by (backend) (chivas_rumberas_http_requests_total{route!~\"/metrics|/health\"})",
          "legendFormat": "{{backend}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput Comparativo en Tiempo Real (req/s, ventana 15s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (backend) (rate(chivas_rumberas_http_requests_total{route!~\"/metrics|/health\"}[15s]))",
          "legendFormat": "{{backend}} (req/s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Tasa de Errores HTTP 5xx (%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * (sum by (backend) (rate(chivas_rumberas_http_requests_total{status_code=~\"5..\"}[15s])) / clamp_min(sum by (backend) (rate(chivas_rumberas_http_requests_total[15s])), 0.0001))",
          "legendFormat": "{{backend}} (5xx %)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latencia p50 (Mediana)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, backend) (rate(chivas_rumberas_http_request_duration_seconds_bucket[15s])))",
          "legendFormat": "{{backend}} p50",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latencia p95 (Criterio Principal Ranking: 30%)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(chivas_rumberas_http_request_duration_seconds_bucket[15s])))",
          "legendFormat": "{{backend}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Latencia p99",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, backend) (rate(chivas_rumberas_http_request_duration_seconds_bucket[15s])))",
          "legendFormat": "{{backend}} p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Consumo de CPU (Cores / %)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"chivas-backend-.*\"}[15s]))",
          "legendFormat": "cAdvisor {{name}}",
          "refId": "A"
        },
        {
          "expr": "sum by (backend) (rate(chivas_rumberas_process_cpu_seconds_total[15s]))",
          "legendFormat": "process {{backend}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Consumo de Memoria (RSS / Container Working Set)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 15 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (name) (container_memory_working_set_bytes{name=~\"chivas-backend-.*\"})",
          "legendFormat": "cAdvisor {{name}}",
          "refId": "A"
        },
        {
          "expr": "max by (backend) (chivas_rumberas_process_resident_memory_bytes)",
          "legendFormat": "RSS {{backend}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "GC Pause Time (JVM: Java/Scala) & Event Loop Lag (Node: Express)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "max by (backend) (chivas_rumberas_nodejs_eventloop_lag_seconds)",
          "legendFormat": "{{backend}} Event Loop Lag",
          "refId": "A"
        },
        {
          "expr": "sum by (backend) (rate(jvm_gc_pause_seconds_sum[15s]))",
          "legendFormat": "{{backend}} JVM GC Pause (s/s)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 11,
      "title": "Curva de Peticiones Entrantes Acumuladas vs. Peticiones por Endpoint (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (backend, route) (rate(chivas_rumberas_http_requests_total{route!~\"/metrics|/health\"}[15s]))",
          "legendFormat": "{{backend}} -> {{route}} (req/s)",
          "refId": "A"
        }
      ]
    }
  ],
